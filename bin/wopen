#!/usr/bin/env bash
# wopen : リモートの Linux 機から、手元の WezTerm(Windows)に頼みごとをする
#   wopen <path>...               Windows の既定のアプリで開く
#   wopen -r|--reveal <path>...   エクスプローラーで表示する
#   wopen --edit <path>           新しいタブで編集する(nvim)
#   wopen --git <dir>             新しいタブで Git(lazygit)を開く
#   wopen --keys                  新しいタブで操作一覧を開く
#   wopen --settings              新しいタブで設定(local.lua)を開く
#   wopen --upload <dir> <Windows のパス>...   Windows のファイルを <dir> に配置する(WezTerm 側で確認が出る)
#
# 端末(手元の WezTerm)へ OSC 1337 SetUserVar=wez_open を送り、WezTerm の設定(wezterm.lua の user-var-changed)が受ける。
# 新しいポートや Windows 側の sshd は要らない。
# tmux の中では passthrough(allow-passthrough on)で包み、pane の端末へ直接書く(nvim などのジョブからでも届くように)。
set -eu

emit() {
  local val seq
  val=$(printf '%s' "$1" | base64 -w0)
  seq=$(printf '\033]1337;SetUserVar=wez_open=%s\007' "$val")
  if [ -n "${TMUX:-}" ]; then
    local tty
    tty=$(tmux display -p -t "${TMUX_PANE:-}" '#{pane_tty}')
    printf '\033Ptmux;%s\033\\' "${seq//$'\033'/$'\033\033'}" > "$tty"
  else
    printf '%s' "$seq" > /dev/tty
  fi
}

# 合言葉(WezTerm がフォルダを開くときに残したもの。tenv-open -k)。合図に付けないと WezTerm は受け付けない。
# 複数の PC からつなぐと PC ごとにあるので、すべてを , でつなげて付ける(WezTerm はどれか 1 つが合えば受け付ける)
token() {
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/tenv/tokens"
  grep -E "^[0-9a-fA-F]+$" "$f" 2>/dev/null | paste -sd, -
}

send() { emit "$1|$2|$(date +%s%N)|$(token)"; }

usage() { sed -n '2,9p' "$0" | sed 's/^# //' >&2; exit 2; }

case "${1:-}" in
  ""|-h|--help) usage ;;
  --settings) send settings / ;;
  --keys) send keys / ;;
  --edit) [ $# -eq 2 ] || usage; send edit "$(realpath -- "$2")" ;;
  --git) [ $# -eq 2 ] || usage; send git "$(realpath -- "$2")" ;;
  --upload)
    [ $# -ge 3 ] || usage
    dest=$(realpath -- "$2"); shift 2
    list="$dest"
    for f in "$@"; do list="$list"$'\n'"$f"; done
    send upload "$list"
    ;;
  *)
    kind=open
    case "$1" in -r|--reveal) kind=reveal; shift ;; esac
    [ $# -gt 0 ] || usage
    for f in "$@"; do
      send "$kind" "$(realpath -- "$f")"
      sleep 0.05
    done
    ;;
esac
